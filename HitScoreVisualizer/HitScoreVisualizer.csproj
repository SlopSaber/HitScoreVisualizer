<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
    <ImportBSMTTargets>true</ImportBSMTTargets>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GameDirectory>D:\BSManager\BSInstances\1.45.2</GameDirectory>
    <CopyPDB>false</CopyPDB>
    <DisableCopyToGame>false</DisableCopyToGame>
		<TargetFramework>net472</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnableFrameworkPathOverride>true</EnableFrameworkPathOverride>
